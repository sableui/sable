{
	"name": "@sableui/react",
	"version": "0.1.1",
	"description": "Sable: themeable React components, layout patterns, and tools for coding agents.",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./patterns": {
			"types": "./src/patterns/index.ts",
			"default": "./src/patterns/index.ts"
		},
		"./styles.css": "./src/styles.css",
		"./themes.css": "./src/themes.css",
		"./layout": {
			"types": "./src/layout/index.ts",
			"default": "./src/layout/index.ts"
		},
		"./icons": {
			"types": "./src/icon/index.ts",
			"default": "./src/icon/index.ts"
		},
		"./themes": {
			"types": "./src/themes/index.ts",
			"default": "./src/themes/index.ts"
		},
		"./theme/meridian": {
			"types": "./src/themes/meridian/index.ts",
			"default": "./src/themes/meridian/index.ts"
		},
		"./theme/meridian.css": "./src/themes/meridian/meridian.css",
		"./theme/atelier": {
			"types": "./src/themes/atelier/index.ts",
			"default": "./src/themes/atelier/index.ts"
		},
		"./theme/atelier.css": "./src/themes/atelier/atelier.css",
		"./theme/prism": {
			"types": "./src/themes/prism/index.ts",
			"default": "./src/themes/prism/index.ts"
		},
		"./theme/prism.css": "./src/themes/prism/prism.css",
		"./theme/verdant": {
			"types": "./src/themes/verdant/index.ts",
			"default": "./src/themes/verdant/index.ts"
		},
		"./theme/verdant.css": "./src/themes/verdant/verdant.css",
		"./registry.json": "./registry.json",
		"./foundations": {
			"types": "./src/foundations/index.ts",
			"default": "./src/foundations/index.ts"
		},
		"./icons/reicon": {
			"types": "./src/icon-sets/reicon.tsx",
			"default": "./src/icon-sets/reicon.tsx"
		},
		"./icons/brands": {
			"types": "./src/icon-sets/brands.tsx",
			"default": "./src/icon-sets/brands.tsx"
		},
		"./theme/ember": {
			"types": "./src/themes/ember/index.ts",
			"default": "./src/themes/ember/index.ts"
		},
		"./theme/ember.css": "./src/themes/ember/ember.css",
		"./theme/base": {
			"types": "./src/themes/base/index.ts",
			"default": "./src/themes/base/index.ts"
		},
		"./theme/base.css": "./src/themes/base/base.css",
		"./theme/poppy": {
			"types": "./src/themes/poppy/index.ts",
			"default": "./src/themes/poppy/index.ts"
		},
		"./theme/poppy.css": "./src/themes/poppy/poppy.css",
		"./presets": {
			"types": "./src/presets/index.ts",
			"default": "./src/presets/index.ts"
		},
		"./ios": {
			"types": "./src/ios/index.ts",
			"default": "./src/ios/index.ts"
		},
		"./ios/preview": {
			"types": "./src/ios/preview.ts",
			"default": "./src/ios/preview.ts"
		},
		"./ios/styles.css": "./src/ios/styles.css",
		"./ios/frame.css": "./src/ios/frame.css"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"contrast:report": "node scripts/contrast-report.mjs",
		"design-lint": "node scripts/design-lint.mjs",
		"build:registry": "node scripts/build-registry.mjs && node scripts/build-ios-target.mjs",
		"build:registry:check": "node scripts/build-registry.mjs --check && node scripts/build-ios-target.mjs --check",
		"icons:brands": "node scripts/fetch-brand-icons.mjs",
		"icons:brands:check": "node scripts/fetch-brand-icons.mjs --check",
		"test": "vitest",
		"test:run": "vitest run",
		"build": "node scripts/build-registry.mjs && node scripts/build-ios-target.mjs && tsup && node scripts/copy-assets.mjs",
		"grade": "node scripts/grade.mjs"
	},
	"files": [
		"targets",
		"skills",
		"dist",
		"bin",
		"scripts/lint-rules.mjs",
		"scripts/skeleton.mjs",
		"scripts/grade.mjs",
		"scripts/review-evidence.mjs",
		"scripts/design-memory.mjs",
		"scripts/design-atlas.mjs",
		"scripts/design-preferences.mjs",
		"scripts/design-directions.mjs",
		"AGENTS.md",
		"CONTRIBUTING.md",
		"DESIGN.md",
		"README.md",
		"CHANGELOG.md",
		"registry.json",
		"llms.txt",
		"llms-full.txt",
		"llms",
		"!llms/atlas",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"third-party",
		"scripts/agent-setup.mjs",
		"scripts/design-presets.mjs"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./patterns": {
				"types": "./dist/patterns/index.d.ts",
				"default": "./dist/patterns/index.js"
			},
			"./styles.css": "./dist/styles.css",
			"./themes.css": "./dist/themes.css",
			"./layout": {
				"types": "./dist/layout/index.d.ts",
				"default": "./dist/layout/index.js"
			},
			"./icons": {
				"types": "./dist/icon/index.d.ts",
				"default": "./dist/icon/index.js"
			},
			"./themes": {
				"types": "./dist/themes/index.d.ts",
				"default": "./dist/themes/index.js"
			},
			"./theme/meridian": {
				"types": "./dist/themes/meridian/index.d.ts",
				"default": "./dist/themes/meridian/index.js"
			},
			"./theme/meridian.css": "./dist/themes/meridian/meridian.css",
			"./theme/atelier": {
				"types": "./dist/themes/atelier/index.d.ts",
				"default": "./dist/themes/atelier/index.js"
			},
			"./theme/atelier.css": "./dist/themes/atelier/atelier.css",
			"./theme/prism": {
				"types": "./dist/themes/prism/index.d.ts",
				"default": "./dist/themes/prism/index.js"
			},
			"./theme/prism.css": "./dist/themes/prism/prism.css",
			"./theme/verdant": {
				"types": "./dist/themes/verdant/index.d.ts",
				"default": "./dist/themes/verdant/index.js"
			},
			"./theme/verdant.css": "./dist/themes/verdant/verdant.css",
			"./registry.json": "./registry.json",
			"./foundations": {
				"types": "./dist/foundations/index.d.ts",
				"default": "./dist/foundations/index.js"
			},
			"./icons/reicon": {
				"types": "./dist/icon-sets/reicon.d.ts",
				"default": "./dist/icon-sets/reicon.js"
			},
			"./icons/brands": {
				"types": "./dist/icon-sets/brands.d.ts",
				"default": "./dist/icon-sets/brands.js"
			},
			"./theme/ember": {
				"types": "./dist/themes/ember/index.d.ts",
				"default": "./dist/themes/ember/index.js"
			},
			"./theme/ember.css": "./dist/themes/ember/ember.css",
			"./theme/base": {
				"types": "./dist/themes/base/index.d.ts",
				"default": "./dist/themes/base/index.js"
			},
			"./theme/base.css": "./dist/themes/base/base.css",
			"./theme/poppy": {
				"types": "./dist/themes/poppy/index.d.ts",
				"default": "./dist/themes/poppy/index.js"
			},
			"./theme/poppy.css": "./dist/themes/poppy/poppy.css",
			"./presets": {
				"types": "./dist/presets/index.d.ts",
				"default": "./dist/presets/index.js"
			},
			"./ios": {
				"types": "./dist/ios/index.d.ts",
				"default": "./dist/ios/index.js"
			},
			"./ios/preview": {
				"types": "./dist/ios/preview.d.ts",
				"default": "./dist/ios/preview.js"
			},
			"./ios/styles.css": "./dist/ios/styles.css",
			"./ios/frame.css": "./dist/ios/frame.css"
		}
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19",
		"tailwindcss": "^4",
		"konsta": "^5.5.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"react-day-picker": "^9.13.2",
		"tailwind-merge": "^3.4.0",
		"reicon-react": "^1.2.0"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest-axe": "^3.5.9",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"jest-axe": "^10.0.0",
		"jsdom": "^29.1.1",
		"reicon-brands": "^1.0.2",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.6",
		"konsta": "^5.5.0"
	},
	"license": "MIT",
	"author": "Sable contributors",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sableui/sable.git"
	},
	"peerDependenciesMeta": {
		"konsta": {
			"optional": true
		}
	},
	"bin": {
		"sable": "./bin/sable.mjs",
		"sable-lint": "./bin/sable-lint.mjs"
	}
}
